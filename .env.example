# Copy to .env before running locally.

# Listen port. Optional — defaults to 3000.
PORT=3001

# Managed Postgres connection string (Supabase/Neon/etc).
DATABASE_URL=

# GDELT polling interval in minutes. Optional — defaults set in code.
GDELT_POLL_INTERVAL_MINUTES=15

# Google Gemini API key for the enrichment pipeline (relevance, classify,
# severity, summarise). Never committed, never exposed to the site or the
# browser. Without it, the poll loop still ingests raw events but nothing
# gets enriched, and `npm run eval` skips instead of failing.
GEMINI_API_KEY=

# Rough monthly spend tripwire for the LLM stream (DESIGN.md §6 targets low
# single-digit USD/month). Optional — defaults to $5. Not a hard cutoff:
# breaching it only logs a [MIS] COST ALERT so someone notices before a
# real bill surprise. See RUNBOOK.md "Cost spike".
LLM_MONTHLY_COST_CEILING_USD=5

# Optional: real-time AIS vessel positions via aisstream.io (free tier
# available at aisstream.io). Without it, /api/v1/vessels still responds,
# just with an empty, unavailable list — the site's map simply shows no
# live ships, same graceful-degradation posture as everything else here.
AISSTREAM_API_KEY=
